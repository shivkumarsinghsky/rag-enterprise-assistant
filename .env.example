# Copy to .env (`cp .env.example .env`). Never commit .env or real API keys.

# Providers: offline defaults need no network or keys.
EMBEDDING_PROVIDER=hashing          # hashing | openai (any OpenAI-compatible /v1/embeddings)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384            # must match the model, e.g. 1536 for text-embedding-3-small
LLM_PROVIDER=extractive             # extractive | openai (any OpenAI-compatible /v1/chat/completions)
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1   # Ollama: http://localhost:11434/v1
OPENAI_API_KEY=

# Storage
VECTOR_STORE=memory                 # memory | pgvector
DATABASE_URL=postgresql://rag:rag-local-dev@localhost:5432/rag

# Retrieval
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=30
TOP_K=5
CANDIDATE_K=20
CONTEXT_BUDGET_WORDS=1200

# API keys → principal (tenant, user, groups). Development stand-in for OIDC tokens.
API_KEYS={"dev-acme-maintenance": {"tenant": "acme", "user": "alice", "groups": ["all-staff", "maintenance"]}, "dev-globex-user-1": {"tenant": "globex", "user": "gina", "groups": []}}
INGEST_ON_START=1
LOG_LEVEL=INFO
